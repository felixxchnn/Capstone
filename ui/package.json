{
  "name": "capstone-research-interface",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Connected, modular presentation layer for the DepMap perturbation-response capstone (reads committed predictions; performs no model inference).",
  "license": "MIT",
  "engines": {
    "node": ">=20.19 <23"
  },
  "scripts": {
    "sync:data": "node scripts/sync-case-study.mjs",
    "predev": "npm run sync:data",
    "prebuild": "npm run sync:data",
    "pretest": "npm run sync:data",
    "dev": "vite",
    "build": "npm run sync:data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "smoke:structure": "node scripts/structure-smoke.mjs"
  },
  "dependencies": {
    "fp-ts": "2.16.11",
    "molstar": "5.11.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "22.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
